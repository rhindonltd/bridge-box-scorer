{
  "name": "bridge-box-scorer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch server.ts",
    "prebuild": "npx tsx src/scripts/migrate.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest --project unit",
    "coverage": "vitest --project unit run --coverage",
    "e2e": "npx playwright test",
    "generate_movements_migration": "npx drizzle-kit generate --config=drizzle.config.movements.ts",
    "run_movements_migration": "npx drizzle-kit migrate --config=drizzle.config.movements.ts",
    "generate_players_migration": "npx drizzle-kit generate --config=drizzle.config.players.ts",
    "run_players_migration": "npx drizzle-kit migrate --config=drizzle.config.players.ts",
    "generate_game_index_migration": "npx drizzle-kit generate --config=drizzle.config.game-index.ts",
    "run_game_index_migration": "npx drizzle-kit migrate --config=drizzle.config.game-index.ts",
    "generate_individual_migration": "npx drizzle-kit generate --config=drizzle.config.game.individual.ts",
    "generate_pairs_migration": "npx drizzle-kit generate --config=drizzle.config.game.pairs.ts",
    "sync:ebu-players": "tsx src/scripts/sync-ebu-players.ts",
    "seed-movements": "tsx src/scripts/seed-movements.ts"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@testing-library/react": "^16.3.2",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "csv-parse": "^7.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "swr": "^2.4.2",
    "ts-node": "^10.9.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@playwright/test": "^1.61.0",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/nextjs-vite": "^10.4.6",
    "@storybook/react": "^10.4.6",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.5.0",
    "eslint-config-next": "16.2.9",
    "eslint-plugin-storybook": "^10.4.6",
    "jsdom": "^29.1.1",
    "next-test-api-route-handler": "^5.0.5",
    "playwright": "^1.61.0",
    "prettier": "^3.8.4",
    "storybook": "^10.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^6",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
