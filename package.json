{
  "name": "bridge-box-scorer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/link-ts6.mjs",
    "dev": "tsx watch server.ts",
    "prebuild": "npx tsx --env-file=.env src/scripts/migrate.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest --project unit",
    "coverage": "vitest --project unit run --coverage --reporter=html --outputFile=unit.html",
    "e2e_ui": "npx playwright test --ui",
    "journey:phone": "playwright test --project=journeys-phone",
    "journey:tablet": "playwright test --project=journeys-tablet",
    "journey:all": "playwright test --project=journeys-phone --project=journeys-tablet",
    "generate_movements_migration": "npx drizzle-kit generate --config=drizzle.config.movements.ts",
    "run_movements_migration": "npx drizzle-kit migrate --config=drizzle.config.movements.ts",
    "generate_players_migration": "npx drizzle-kit generate --config=drizzle.config.players.ts",
    "run_players_migration": "npx drizzle-kit migrate --config=drizzle.config.players.ts",
    "generate_game_index_migration": "npx drizzle-kit generate --config=drizzle.config.game-index.ts",
    "run_game_index_migration": "npx drizzle-kit migrate --config=drizzle.config.game-index.ts",
    "generate_system_migration": "npx drizzle-kit generate --config=drizzle.config.system.ts",
    "run_system_migration": "npx drizzle-kit migrate --config=drizzle.config.system.ts",
    "sync:ebu-players": "tsx --env-file=.env src/scripts/sync-ebu-players.ts",
    "seed-movements": "tsx --env-file=.env src/scripts/seed-movements.ts"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "csv-parse": "^7.0.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "swr": "^2.5.1",
    "xmlbuilder2": "^4.0.3",
    "zod": "^4.5.2",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "eslint-config-next": {
      "typescript-eslint": {
        "typescript": "^6"
      }
    },
    "ts-api-utils": {
      "typescript": "^6"
    }
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/nextjs-vite": "^10.5.10",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "eslint-config-next": "16.3.3",
    "eslint-plugin-storybook": "^10.5.10",
    "jsdom": "^30.0.1",
    "next-test-api-route-handler": "^5.0.7",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "storybook": "^10.5.10",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^7",
    "typescript-6": "npm:typescript@^6",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
